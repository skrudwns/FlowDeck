# backend/.env로 복사해서 쓴다. .env는 커밋하지 않는다.

# 로컬 개발: 저장소 루트의 compose.yaml로 띄운 Postgres
DATABASE_URL=postgresql://flowdeck:flowdeck@localhost:5433/flowdeck

# 포털에서 수집을 바로 실행할 때 쓰는 GitHub 토큰 (ADR-0011). 없으면 다음 정기 호출 때 실행된다.
# fine-grained token: 이 저장소만, 권한은 Actions 읽기·쓰기만. cron-job.org 토큰과 따로 만든다
# PORTAL_GITHUB_TOKEN=
